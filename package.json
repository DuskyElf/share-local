		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^26.6.6",
		"canvas-confetti": "^1.9.4",
		"clsx": "^2.1.1",
		"eslint": "^10.14.0",
